# =============================================================================
# بيئة التشغيل والإعدادات العامة - نظام المحاسبة والفوترة الإلكترونية (السعودية)
# Environment Configuration - Saudi Accounting & E-Invoicing System
# =============================================================================

# منفذ الخادم (الافتراضي: 3000)
PORT=3000

# بيئة التشغيل: development | production | test
NODE_ENV=development

# وضع العرض التجريبي (Demo Mode)
# true: تفعيل التخزين المحلي في المتصفح وعرض البيانات التجريبية مع بانر الوضع التجريبي
# false: وضع التشغيل المخصص للتكامل المباشر
VITE_DEMO_MODE=true

# مفتاح Google Gemini AI (يتم حقنه تلقائياً في Google AI Studio)
# يستخدم للخدمات الذكية (المستشار المالي، فحص القيود، التنبؤات، تدقيق الزكاة)
GEMINI_API_KEY=

# رابط التطبيق الأساسي (URL)
# يتم تعيينه تلقائياً في AI Studio أو عنوان الخادم الخاص بك محلياً
APP_URL=http://localhost:3000

# الحد الأقصى لحجم طلبات JSON (مثل: 1mb, 2mb)
JSON_BODY_LIMIT=1mb
